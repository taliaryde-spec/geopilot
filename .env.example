# Copy this file to .env and fill in your own key.
# Never commit or share a real API key.

# Active provider: openai, deepseek, or openrouter.
GEOPILOT_PROVIDER=deepseek

# DeepSeek direct API. The model default is deepseek-v4-flash.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter alternative. Its model ID must be specified explicitly.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=provider/model-name

# OpenAI alternative. The model default is gpt-5-mini.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Optional generic overrides for custom OpenAI-compatible endpoints.
# GEOPILOT_API_KEY=
# GEOPILOT_MODEL=
# GEOPILOT_BASE_URL=

GEOPILOT_MODEL_TIMEOUT_SECONDS=30
GEOPILOT_MODEL_MAX_RETRIES=2
GEOPILOT_MODEL_MAX_OUTPUT_TOKENS=4096
